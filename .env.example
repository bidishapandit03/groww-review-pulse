# Copy to .env.local and fill real values. NEVER commit .env.local.

# Mistral (https://console.mistral.ai) — required for tagging + note
MISTRAL_API_KEY=

# Vercel Blob — for raw review storage in production (create a store in Vercel dashboard)
BLOB_READ_WRITE_TOKEN=

# Gmail API (OAuth2) — used to create the email draft
# Download `credentials.json` from Google Cloud console into the repo root
GMAIL_CREDENTIALS_PATH=credentials.json
# OAuth2 refresh token obtained after one-time authorization (node scripts/authorize-gmail.ts)
GMAIL_REFRESH_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Recipient of the weekly pulse draft
GMAIL_RECIPIENT=

# Optional: admin UI password (leave empty = admin open)
ADMIN_PASSWORD=

# Recipient for the .eml fallback draft (default: the project's review mailbox)
EMAIL_RECIPIENT=

# GitHub fine-grained PAT with "contents: write" on this repo, to commit generated notes
# (optional; the weekly note is also stored in Vercel Blob)
GH_PAT=